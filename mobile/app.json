{
  "expo": {
    "name": "Nostos",
    "slug": "garage-monitor",
    "scheme": "garage-monitor",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "studio.naus.garagemonitor",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "./plugins/withLocalNotifications",
      "expo-notifications",
      "expo-secure-store"
    ],
    "icon": "./assets/app-icon.png"
  }
}
